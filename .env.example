# Copy this file to .env and fill in your values
# Run: cp .env.example .env

# Your Anthropic API key (get from console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-your_key_here

# Gmail sending credentials
# IMPORTANT: Use a Gmail App Password, NOT your regular Gmail password
# Get one at: myaccount.google.com/apppasswords
# (Requires 2FA enabled on your Google account)
SENDER_EMAIL=your_gmail@gmail.com
SENDER_EMAIL_PASSWORD=xxxx_xxxx_xxxx_xxxx

# Your identity for outreach emails (company name is always "Wholesale Omniverse")
SENDER_NAME=Your Name
SENDER_PHONE=555-000-0000

# ─── OMNIVERSE Animation Studio API Keys ─────────────────────────────────────

# Replicate — open-source animation models (Wan 2.1, Kling, AnimateDiff, SVD)
# Get key: replicate.com/account/api-tokens
REPLICATE_API_KEY=r8_your_key_here

# RunwayML Gen-3 Alpha Turbo — high-quality commercial video generation
# Get key: app.runwayml.com → Settings → API
RUNWAYML_API_KEY=your_runway_key_here

# Stability AI — Stable Video Diffusion
# Get key: platform.stability.ai/account/keys
STABILITY_API_KEY=sk-your_stability_key_here

# LumaLabs Dream Machine — physics-based high quality video
# Get key: lumalabs.ai/dream-machine/api
LUMALABS_API_KEY=your_luma_key_here

# ─── OMNIVERSE Dubbing / Text-to-Speech API Keys ─────────────────────────────

# ElevenLabs — BEST quality TTS, emotion control, voice cloning, 30+ languages (RECOMMENDED)
# Get key: elevenlabs.io → Profile → API Key
ELEVENLABS_API_KEY=your_elevenlabs_key_here

# OpenAI TTS — fast clean voices (alloy, echo, fable, onyx, nova, shimmer), HD option
# Uses same key as OpenAI API — platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_key_here

# gTTS (Google TTS) is FREE and requires NO API KEY — installed automatically
# Lower quality than ElevenLabs/OpenAI but works out of the box

# ─── Media Buyer agent (media_buyer/) ────────────────────────────────────────
# Autonomous Meta campaign optimizer. DRY_RUN by default; uncomment MB_LIVE only
# after reviewing a few entries in data/media_buyer/controller_audit.jsonl.

# Required for the lead-gen profile:
META_AD_ACCOUNT_ID=act_REPLACE_ME              # Business Manager → Ad Accounts
MB_LEADGEN_PIXEL_ID=REPLACE_ME                 # Events Manager → Pixels (15-16 digit numeric)
MB_LEADGEN_TARGET_CPL=25                       # Max acceptable cost per lead, USD
MB_LEADGEN_ALERT_EMAIL=your_email@example.com  # Daily report destination

# Required to subscribe Meta's leadgen webhook (any random string you choose,
# pasted into Meta when subscribing). Generate with: python3 -c "import secrets; print('mb_wh_'+secrets.token_hex(16))"
META_WEBHOOK_VERIFY_TOKEN=mb_wh_replace_with_random_hex

# Optional — uncomment ONLY after watching dry-run audit logs.
# MB_LIVE=1

# Optional — e-com profile (parallel set; only needed if running --kind ecom)
# MB_ECOM_AD_ACCOUNT_ID=act_...
# MB_ECOM_PIXEL_ID=...
# MB_ECOM_BREAKEVEN_ROAS=1.8
# MB_ECOM_TARGET_AOV=45
# MB_ECOM_SLACK_WEBHOOK=https://hooks.slack.com/services/...
# MB_ECOM_ALERT_EMAIL=ops@example.com

# Optional — companion services the FastAPI webhook server depends on
# (run_media_buyer_server.py). Cron-only usage doesn't need these.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx   # required for lead-gen phone validation
# TWILIO_AUTH_TOKEN=your_twilio_token
# SHOPIFY_WEBHOOK_SECRET=shpss_xxxxxxxxxxxxxxxxxxxxxxxx    # required to verify Shopify order webhooks
# MB_CRM_WEBHOOK_URL=https://hooks.zapier.com/...           # optional CRM forward
# MB_LEADGEN_SLACK_WEBHOOK=https://hooks.slack.com/services/...
# MB_WINNING_DAILY_THRESHOLD=25                              # alert when a SKU crosses this many orders/day

# Safety caps (defaults in code; only set to override)
# MB_MAX_DAILY_INCREASE_PCT=30                               # caps any single scale step
# MB_MAX_DAILY_BUDGET_USD=500                                # caps post-mutation absolute daily budget

# ICT Predictor — MetaTrader 5 order submission (optional; only needed to
# actually submit orders — report generation works without any of this).
# MT5_LOGIN=12345678
# MT5_PASSWORD=your_mt5_password
# MT5_SERVER=YourBroker-ServerName
# MT5_PATH=C:\Path\To\terminal64.exe   # optional, if not on default install path
# IP_MT5_LIVE=1                        # DANGER: arms real order submission. Omit/0 = dry-run.
# IP_MT5_ALLOW_REAL=1                  # DANGER: allows non-demo accounts. Omit/0 = demo/contest only.

# Per-agent Stripe payment link, used by paywall/agent_paywall.py. The var is
# STRIPE_LINK_<AGENT_KEY_UPPERCASED>; without it the paywall falls back to
# paypal.me/$PAYPAL_ME_USERNAME. NOTE: the charged amount comes from the Stripe
# dashboard, not from DEFAULT_PRICES in agent_paywall.py — keep them in sync.
# A buy.stripe.com/test_... link is sandbox-only and cannot take real payments.
# STRIPE_LINK_ICT_PREDICTOR=https://buy.stripe.com/live_xxxxxxxxxxxxxxxx

# --- Amazon Influencer x Pinterest Agent (amazon_pinterest_agent/) ---
# Your Amazon Associates/Influencer tracking ID (e.g. "wholesaleom-20"). Can
# also be set per-storefront in data/ap_storefront.json's "associate_tag" key.
AMAZON_ASSOCIATE_TAG=your-associate-tag-20

# Pinterest OAuth access token — scopes: pins:write, boards:read.
# Generate via setup_pinterest.py or the Pinterest developer app OAuth flow.
PINTEREST_ACCESS_TOKEN=
# Fallback single board (used when AP_BOARD_MAP doesn't cover a category)
PINTEREST_BOARD_ID=
# Optional — JSON string mapping product category -> Pinterest board_id, e.g.
# AP_BOARD_MAP={"kitchen":"1234567890","fitness":"2345678901","default":"9999999999"}
AP_BOARD_MAP=

# Optional tuning (defaults shown)
# AP_MAX_PINS_PER_RUN=5           # cap pins dispatched per cycle
# AP_PRODUCT_REPIN_DAYS=21        # cooldown before the same ASIN is re-pinned
# AP_MIN_SECONDS_BETWEEN_PINS=1200 # 20 min spacing between pins (anti-spam)
# AP_IMAGE_REUSE_COOLDOWN_DAYS=14 # don't reuse the same product image sooner than this

# ─── VideoEditor / TikTok Content Posting API ────────────────────────────────
# Get from: developers.tiktok.com → My Apps → your app → Manage
TIKTOK_CLIENT_KEY=your_client_key_here
TIKTOK_CLIENT_SECRET=your_client_secret_here
# Run python3 setup_tiktok.py once to authorize — fills in the line below:
# TIKTOK_ACCESS_TOKEN=
# TIKTOK_REFRESH_TOKEN=

# Set to 1 to auto-post to TikTok every time a video is processed
# TIKTOK_AUTO_POST=1

# ─── PolyMarket Weather Trading Agent ────────────────────────────────────────
# API credentials from polymarket.com → Settings → API Keys
PW_PRIVATE_KEY=your_private_key_here
PW_API_KEY=your_api_key_here
PW_API_SECRET=your_api_secret_here
PW_API_PASSPHRASE=your_passphrase_here

# Trading parameters (defaults shown)
# PW_BANKROLL=1000.0           # starting bankroll in USD
# PW_MIN_EDGE=0.07             # minimum model-vs-market edge to trade (7%)
# PW_KELLY_FRACTION=0.25       # fraction of full Kelly to bet (25%)
# PW_MAX_POSITION_PCT=0.05     # max single position as % of bankroll (5%)
# PW_MIN_LIQUIDITY=500.0       # minimum market liquidity in USD
# PW_RETRAIN_DAYS=7            # retrain model every N days
# PW_DATA_REFRESH_HOURS=6      # refresh weather data every N hours
# PW_CITIES=new_york,chicago,miami,atlanta,dallas
# PW_CYCLE_MINUTES=60          # trading loop interval

# Set to 1 to place real orders (default is dry-run)
PW_LIVE_TRADING=0

# Optional — email daily digest to this address
# PW_OWNER_EMAIL=your@email.com

# ─── Render Outbound IP Ranges (for API allowlisting if ever required) ───────
# If PolyMarket or any external API starts requiring IP allowlisting,
# submit these Render egress CIDRs:
#   74.220.48.0/24
#   74.220.56.0/24
